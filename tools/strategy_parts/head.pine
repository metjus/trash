//  • Leverage: set "Margin for long/short positions" in Properties to 100 / leverage (default 20 % = 5×).
//@version=6
strategy("CFE Strategy — Confluence Futures Engine", shorttitle = "CFE-S", overlay = true, initial_capital = 10000, currency = currency.USD, default_qty_type = strategy.fixed, default_qty_value = 1, commission_type = strategy.commission.percent, commission_value = 0.05, slippage = 2, pyramiding = 3, margin_long = 20, margin_short = 20, process_orders_on_close = true, calc_on_every_tick = false, backtest_fill_limits_assumption = 1, max_labels_count = 500, max_lines_count = 500, max_bars_back = 600)

